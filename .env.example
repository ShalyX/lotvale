# Copy to .env.local for local development. Never commit the real key.
SERV_API_KEY=your_serv_reasoning_key
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEON_AUTH_BASE_URL=https://your-neon-auth-host/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace_with_at_least_32_random_characters
